{
  "expo": {
    "name": "Where Is My Bus",
    "slug": "where-is-my-bus",
    "version": "1.0.0",
    "scheme": "whereismybus",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.whereismybus.app"
    },
    "android": {
      "package": "in.whereismybus.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F1F3D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Where Is My Bus uses your location only while you track a bus you're on."
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
